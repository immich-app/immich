# =============================================================================
# immich-go environment template.
# Copy to .env  ->  cp .env.example .env  ->  edit values.
# Used by docker-compose.yml AND by the native installer (/etc/immich-go.env).
# =============================================================================

# REQUIRED - sign JWTs with a long random secret. Generate one with:
#   openssl rand -hex 32
IMMICHGO_JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# First-run admin account (created ONLY while the database is still empty).
# After first login, change the password in the app; these vars become inert.
IMMICHGO_ADMIN_EMAIL=admin@example.com
IMMICHGO_ADMIN_PASSWORD=ChangeMe123!

# HTTP port (Immich default = 2283)
IMMICHGO_PORT=2283

# Where data lives. For Docker/Podman containers keep /data (it is a volume).
# For native installs the installer rewrites this to /var/lib/immich-go.
IMMICHGO_DATA_DIR=/data

# --- ODROID-C2 tuning (safe defaults; usually no need to touch) --------------
IMMICHGO_DB_MAX_CONNS=5
IMMICHGO_IMAGE_WORKERS=2
IMMICHGO_MAX_IMAGE_WIDTH=2048
IMMICHGO_JPEG_QUALITY=80
IMMICHGO_WORKER_INTERVAL=30s
IMMICHGO_WORKER_SLEEP=2s
IMMICHGO_MEMORY_LIMIT_MB=500
GIN_MODE=release

# --- Only needed when running the legacy importer via compose ----------------
# PostgreSQL connection string of the OLD Immich server:
LEGACY_DSN=postgres://immich:secret@192.168.1.50:5432/immich?sslmode=disable
# Host path of the OLD library/upload folder (mounted read-only into migrate):
LEGACY_LIBRARY_HOST_PATH=/mnt/old-immich-upload
